set_option linter.unusedSimpArgs false in
theorem runInstrSeq_round0 (s : State) (startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant : UInt256)
    (x : EvmWorking) (rest : List UInt256)
    (hstack : rest.length < 1000) (hrun : s.halt = .Running)
    (hactive : 67 ≤ s.activeWords.toNat)
    (hp0 : p0.toNat + 32 ≤ 2144) (hp1 : p1.toNat + 32 ≤ 2144)
    (hp2 : p2.toNat + 32 ≤ 2144) (hp3 : p3.toNat + 32 ≤ 2144) :
    runInstrSeq (seg2_0 ++ seg2_1 constant)
      { s with pc := startPC, stack := [p0, returnPC, M0, p1, M1, p2, M2, p3, M3, x.a, x.b, x.c, x.d, x.e] ++ rest } =
    some { s with pc := pcAfter startPC (seg2_0 ++ seg2_1 constant), stack := [(qRound x 2 (MachineState.readWord s.memory p0.toNat) M0 constant).d, p1, M1, p2, M2, p3, M3, returnPC, (qRound x 2 (MachineState.readWord s.memory p0.toNat) M0 constant).c, (qRound x 2 (MachineState.readWord s.memory p0.toNat) M0 constant).b, (qRound x 2 (MachineState.readWord s.memory p0.toNat) M0 constant).e, (qRound x 2 (MachineState.readWord s.memory p0.toNat) M0 constant).a] ++ rest } := by
  have hcap (m : Nat) (hm : m ≤ 24) : rest.length + m < 1024 := by omega
  have hadd (u v : UInt256) : u + v = u.add v := rfl
  have hA0 := ScheduleActiveWords.activeWordsAfterUInt256_eq s p0.toNat 32 (by omega)
  simp only [State.activeWordsAfterUInt256] at hA0
  have hA1 := ScheduleActiveWords.activeWordsAfterUInt256_eq s p1.toNat 32 (by omega)
  simp only [State.activeWordsAfterUInt256] at hA1
  have hA2 := ScheduleActiveWords.activeWordsAfterUInt256_eq s p2.toNat 32 (by omega)
  simp only [State.activeWordsAfterUInt256] at hA2
  have hA3 := ScheduleActiveWords.activeWordsAfterUInt256_eq s p3.toNat 32 (by omega)
  simp only [State.activeWordsAfterUInt256] at hA3
  simp (config := { maxSteps := 2000000 }) (discharger := omega)
    [seg2_0, seg2_1, qRound, qf, qSum, runInstrSeq, Stepper.runInstr,
      op, push1, push4, push5, mask, foldM, List.exchange, hrun, hcap, hadd, pcAfter,
      exchange_swap1, exchange_swap2, exchange_swap3, exchange_swap4, exchange_swap5, exchange_swap6,
      exchange_swap7, exchange_swap8, exchange_swap9, exchange_swap10, exchange_swap11, exchange_swap12,
      State.activeWordsAfterUInt256, hA0, hA1, hA2, hA3,
      UInt256.succ, Instr.size, Instr.size_push, Instr.size_op, Nat.add_assoc,
      Challenge.EvmProof.Word.word_toNat_ofNat, Challenge.EvmProof.Word.ofNat_add_mod,
      Challenge.EvmProof.Word.succ_ofNat, List.getElem?_cons_zero, List.getElem?_cons_succ]

