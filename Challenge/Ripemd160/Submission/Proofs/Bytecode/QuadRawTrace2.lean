/-- Complete before-jump evaluation of the quad helper for this form. -/
theorem runInstrSeq_template (s : State) (startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant : UInt256)
    (x : EvmWorking) (rest : List UInt256)
    (hstack : rest.length < 1000) (hrun : s.halt = .Running)
    (hactive : 67 ≤ s.activeWords.toNat)
    (hp0 : p0.toNat + 32 ≤ 2144) (hp1 : p1.toNat + 32 ≤ 2144)
    (hp2 : p2.toNat + 32 ≤ 2144) (hp3 : p3.toNat + 32 ≤ 2144) :
    runInstrSeq (quadBeforeJumpTemplate 2 constant)
      (quadHelperEntry s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 x rest) =
    some (quadAfterHelperBeforeJump s (pcAfter startPC (quadBeforeJumpTemplate 2 constant))
      returnPC (quadWorking s x 2 p0 p1 p2 p3 M0 M1 M2 M3 constant) rest) := by
  have hrun' : ∀ (pc : UInt256) (st : List UInt256),
      ({ s with pc := pc, stack := st } : State).halt = .Running := by
    intro pc st; simpa using hrun
  have h0 := runInstrSeq_round0 s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant x rest hstack hrun hactive hp0 hp1 hp2 hp3
  have h1 := runInstrSeq_round1 s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant x rest hstack hrun hactive hp0 hp1 hp2 hp3
  have h2 := runInstrSeq_round2 s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant x rest hstack hrun hactive hp0 hp1 hp2 hp3
  have h3 := runInstrSeq_round3 s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant x rest hstack hrun hactive hp0 hp1 hp2 hp3
  have h5 := runInstrSeq_fixup s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 constant x rest hstack hrun hactive hp0 hp1 hp2 hp3
  have hentry : quadHelperEntry s startPC p0 p1 p2 p3 returnPC M0 M1 M2 M3 x rest =
