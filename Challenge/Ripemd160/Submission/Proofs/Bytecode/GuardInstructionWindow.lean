theorem get (index : Nat) :
    Artifact.submissionArtifact.instructions[3716 + index]? = tail[index]? := by
  rw [← InstructionWindow.get_drop, tail_eq]

theorem pc (index : Nat) :
    Artifact.submissionArtifact.instructionPC (3716 + index) =
      4667 + byteLength (tail.take index) := by
  rw [InstructionWindow.pc_drop, pc_base, tail_eq]

