theorem paddedMessage_split :
    Padding.paddedMessage patternedInput =
      patternedInput ++
        (ByteArray.mk #[0x80] ++ Padding.zeroBytes patternedInput.size ++
          Padding.lengthBytes patternedInput) := by
  unfold Padding.paddedMessage
  simp only [ByteArray.append_assoc]

theorem canonicalTail_patterned :
    HashSpecBridge.canonicalTail patternedInput = finalBlock := by
  rw [HashSpecBridge.canonicalTail_eq, patternedInput_size]
  change patternedInput.extract (1000 / 64 * 64) 1000 ++
      ByteArray.mk #[0x80] ++ Padding.zeroBytes 1000 ++
      Padding.lengthBytes patternedInput = finalBlock
  simp [finalBlock]

