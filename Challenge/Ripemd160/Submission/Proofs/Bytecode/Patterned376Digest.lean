private theorem zerosLiteral_size : zerosLiteral.size = 63 := by decide

private theorem zeroBytes_eq_zeros : Padding.zeroBytes 376 = zerosLiteral := by
  unfold Padding.zeroBytes Padding.zeroCount Padding.paddedLength zerosLiteral
  decide

private def lengthLiteral : ByteArray := ByteArray.mk #[
  0xc0, 0x0b, 0, 0, 0, 0, 0, 0]

private theorem lengthBytes_eq_length :
    Padding.lengthBytes patterned376Input = lengthLiteral := by
  apply ByteArray.ext_getElem
  · rw [show (Padding.lengthBytes patterned376Input).size = 8 by
      simp only [Padding.lengthBytes, ByteArray.size_ofFn]]
    decide
  · intro i hleft _hright
    have hi : i < 8 := by
      simpa only [Padding.lengthBytes, ByteArray.size_ofFn] using hleft
    rw [Padding.lengthByte patterned376Input i hi, patterned376Input_size]
    interval_cases i <;>
      norm_num [lengthLiteral, ByteArray.getElem_eq_getElem_data,
        ByteArray.size] <;>
      decide

theorem paddedMessage_eq :
    Padding.paddedMessage patterned376Input = paddedLiteral := by
  unfold Padding.paddedMessage
  simp only [patterned376Input_size]
  rw [zeroBytes_eq_zeros, lengthBytes_eq_length]
  unfold zerosLiteral lengthLiteral
  apply ByteArray.ext
  simp [patterned376Input, paddedLiteral, ByteArray.data_append]

