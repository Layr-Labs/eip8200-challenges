import Challenge.Ripemd160.Benchmark.Artifact
import Challenge.Ripemd160.Submission.Bytecode
set_option warningAsError true
set_option maxRecDepth 1000000
set_option maxHeartbeats 8000000

/-!
# Exact-byte binding for the frozen RIPEMD-160 artifact

The submission's own literal (`submissionBytecode`, from `Submission/Bytes.lean`,
which is the submitted `bytecode.hex`) and the protected artifact's literal
(`Benchmark.bytecode`, regenerated by the trusted harness from the same hex) are
the same 9742-byte array.  Kernel definitional reduction closes the equality
directly, so no piece/chunk bookkeeping is needed: every intermediate literal
would be the same array.
-/

namespace Challenge.Ripemd160.Submission.Proofs.Bytecode.BytecodeBinding

open Challenge.Ripemd160

theorem exact : Benchmark.bytecode = submissionBytecode := by
  rfl

end Challenge.Ripemd160.Submission.Proofs.Bytecode.BytecodeBinding
