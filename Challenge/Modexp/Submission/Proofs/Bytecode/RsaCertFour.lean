theorem exp_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesFour input) :
    Precompile.bytesToNatPadded input 352 3 = 65537 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, hw9, hw10, hw11, hw12, hw13, hw14, hw15⟩
  have hsh : UInt256.ofNat ((32 - 3) * 8) = (232 : UInt256) := by decide
  have e1 : UInt256.ofNat (Precompile.bytesToNatPadded input 352 3) =
      (65537 : UInt256) := by
    rw [← Challenge.EvmProof.Bytes.shiftRight_readWord input 352 3
      (by omega) (by omega)]
    rw [hsh]
    exact hexp.symm
  have e2 := congrArg UInt256.toNat e1
  have hlt : Precompile.bytesToNatPadded input 352 3 < 2 ^ 256 := by
    have hh := Challenge.EvmProof.Bytes.bytesToNatPadded_lt_pow input 352 3
    have h256 : (256:ℕ) ^ 3 < 2 ^ 256 := by decide
    omega
  have hlit : ((65537 : UInt256)).toNat = 65537 := by decide
  rw [Challenge.EvmProof.Word.word_toNat_ofNat, Nat.mod_eq_of_lt hlt, hlit] at e2
  exact e2

