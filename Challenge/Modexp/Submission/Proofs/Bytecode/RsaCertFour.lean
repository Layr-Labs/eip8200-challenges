theorem base_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesFour input) :
    Precompile.bytesToNatPadded input 96 256 =  := by
    rw [show (256:ℕ) = 32 + (32 + (32 + (32 + (32 + (32 + (32 + (32))))))) from rfl,
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input 96 32 (32 + (32 + (32 + (32 + (32 + (32 + (32))))))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (96 + 32) 32 (32 + (32 + (32 + (32 + (32 + (32)))))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((96 + 32) + 32) 32 (32 + (32 + (32 + (32 + (32))))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (((96 + 32) + 32) + 32) 32 (32 + (32 + (32 + (32)))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((((96 + 32) + 32) + 32) + 32) 32 (32 + (32 + (32))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (((((96 + 32) + 32) + 32) + 32) + 32) 32 (32 + (32)),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((((((96 + 32) + 32) + 32) + 32) + 32) + 32) 32 (32),
      show (((((((96 + 32) + 32) + 32) + 32) + 32) + 32) + 32) = 320 from rfl,
      show ((((((96 + 32) + 32) + 32) + 32) + 32) + 32) = 288 from rfl,
      show (((((96 + 32) + 32) + 32) + 32) + 32) = 256 from rfl,
      show ((((96 + 32) + 32) + 32) + 32) = 224 from rfl,
      show (((96 + 32) + 32) + 32) = 192 from rfl,
      show ((96 + 32) + 32) = 160 from rfl,
      show (96 + 32) = 128 from rfl,
      gather0 input h, gather1 input h, gather2 input h, gather3 input h, gather4 input h, gather5 input h, gather6 input h, gather7 input h]
    decide

