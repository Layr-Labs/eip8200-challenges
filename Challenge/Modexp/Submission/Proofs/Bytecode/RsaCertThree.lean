theorem exp_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesThree input) :
    Precompile.bytesToNatPadded input 352 1 = 3 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, hw9, hw10, hw11, hw12, hw13, hw14, hw15⟩
  have hsh : UInt256.ofNat ((32 - 1) * 8) = (248 : UInt256) := by decide
  have e1 : UInt256.ofNat (Precompile.bytesToNatPadded input 352 1) =
      (3 : UInt256) := by
    rw [← Challenge.EvmProof.Bytes.shiftRight_readWord input 352 1
      (by omega) (by omega)]
    rw [hsh]
    exact hexp.symm
  have e2 := congrArg UInt256.toNat e1
  have hlt : Precompile.bytesToNatPadded input 352 1 < 2 ^ 256 := by
    have hh := Challenge.EvmProof.Bytes.bytesToNatPadded_lt_pow input 352 1
    have h256 : (256:ℕ) ^ 1 < 2 ^ 256 := by decide
    omega
  have hlit : ((3 : UInt256)).toNat = 3 := by decide
  rw [Challenge.EvmProof.Word.word_toNat_ofNat, Nat.mod_eq_of_lt hlt, hlit] at e2
  exact e2

private theorem c1 :  %  =  := by decide
private theorem c2 : ( * ) %  =  := by decide
private theorem cE : ( * ) %  =  := by decide

private theorem e1 :  ^ 1 %  =  := by
  rw [pow_one]

private theorem e2 :  ^ 2 %  =  := by
  rw [show (2:ℕ) = 1 + 1 from rfl, Nat.pow_add, Nat.mul_mod, e1, c2]

theorem pow_eq :  ^ 3 %  =  := by
  rw [show (3:ℕ) = 2 + 1 from rfl, pow_succ, Nat.mul_mod, e2, c1, cE]

theorem spec_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesThree input) :
    Challenge.Modexp.spec input = Precompile.natToBytes  256 := by
  have hbs : baseSize input = 256 := (destr input h).1
  have hes : exponentSize input = 1 := (destr input h).2.1
  have hms : modulusSize input = 256 := (destr input h).2.2
  have hbase := base_eq input h
  have hexp2 := exp_eq input h
  have hmod := mod_eq input h
  have hexp2' : Precompile.bytesToNatPadded input (96 + 256) 1 = 3 := by
    rw [show (96:ℕ) + 256 = 352 from rfl]
    exact hexp2
  have hmod' : Precompile.bytesToNatPadded input ((96 + 256) + 1) 256 =  := by
    rw [show ((96:ℕ) + 256) + 1 = 353 from rfl]
    exact hmod
  unfold Challenge.Modexp.spec
  rw [hbs, hes, hms]
  simp only [hbase, hexp2', hmod',
    Challenge.Modexp.Submission.Proofs.Algorithm.modPow_eq]
  rw [if_neg (by decide :  ≠ 0), pow_eq, if_neg (by decide : 256 ≠ 0)]

end Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertThree
