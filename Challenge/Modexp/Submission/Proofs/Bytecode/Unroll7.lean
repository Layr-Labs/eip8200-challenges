  unfold gasSteps_bitCopy7_sym
  have c2484 := blockCostW [opAt 2454 (.Dup ⟨7, by decide⟩)] 3
    (blockOfW _ (pcFactW s 2454 3226 ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2537)
      (stepW_dup s 3226 7 (by decide) ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (m) (by rfl) (by simp; omega) (by norm_num))) hs.fork (by decide) (by rfl) (by rfl)
  have c2485 := blockCostW [pushAt 2455 1 1] 3
