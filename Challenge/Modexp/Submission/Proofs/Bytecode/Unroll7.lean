    (gasSteps_bitCopy7_sym s rest Bm1 zero byte offset outerW acc base m hs hrest).cost = 56 := by
  unfold gasSteps_bitCopy7_sym
  have c2484 := blockCostW [opAt 2421 (.Dup ⟨7, by decide⟩)] 3
    (blockOfW _ (pcFactW s 2421 3130 ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2537)
      (stepW_dup s 3130 7 (by decide) ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (m) (by rfl) (by simp; omega) (by norm_num))) hs.fork (by decide) (by rfl) (by rfl)
  have c2485 := blockCostW [pushAt 2422 1 1] 3
    (blockOfW _ (pcFactW s 2422 3131 ([m, Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2538)
