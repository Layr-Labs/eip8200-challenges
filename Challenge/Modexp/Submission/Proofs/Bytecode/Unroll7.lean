  have step2497 := soundW hs (opAt 2465 .MULMOD)
    (blockOfW _ (pcFactW s 2465 3239 ([acc, acc, m, ((1 : UInt256) + (Bm1 * (UInt256.land (UInt256.shiftRight byte (0 : UInt256)) (1 : UInt256)))), m, Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2550)
