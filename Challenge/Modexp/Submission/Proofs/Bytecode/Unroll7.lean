  have step2484 := soundW hs (opAt 2631 (.Dup ⟨7, by decide⟩))
    (blockOfW _ (pcFactW s 2631 3592 ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2537)
      (stepW_dup s 3592 7 (by decide) ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (m) (by rfl) (by simp; omega) (by norm_num)))
  have step2485 := soundW hs (pushAt 2632 1 1)
