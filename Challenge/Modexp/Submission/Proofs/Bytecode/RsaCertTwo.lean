      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (227 + 32) 32 (32 + (32)),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((227 + 32) + 32) 32 (32),
      show (((227 + 32) + 32) + 32) = 323 from rfl,
      show ((227 + 32) + 32) = 291 from rfl,
      show (227 + 32) = 259 from rfl,
      gather4 input h, gather5 input h, gather6 input h, gather7 input h]
    decide

theorem exp_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesTwo input) :
    Precompile.bytesToNatPadded input 224 3 = 65537 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7⟩
  have hsh : UInt256.ofNat ((32 - 3) * 8) = (232 : UInt256) := by decide
  have e1 : UInt256.ofNat (Precompile.bytesToNatPadded input 224 3) =
      (65537 : UInt256) := by
    rw [← Challenge.EvmProof.Bytes.shiftRight_readWord input 224 3
      (by omega) (by omega)]
    rw [hsh]
    exact hexp.symm
  have e2 := congrArg UInt256.toNat e1
  have hlt : Precompile.bytesToNatPadded input 224 3 < 2 ^ 256 := by
    have hh := Challenge.EvmProof.Bytes.bytesToNatPadded_lt_pow input 224 3
    have h256 : (256:ℕ) ^ 3 < 2 ^ 256 := by decide
    omega
  have hlit : ((65537 : UInt256)).toNat = 65537 := by decide
  rw [Challenge.EvmProof.Word.word_toNat_ofNat, Nat.mod_eq_of_lt hlt, hlit] at e2
  exact e2

