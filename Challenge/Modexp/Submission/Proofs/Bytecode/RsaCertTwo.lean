private theorem destr (input : ByteArray)
    (h : RsaGuardLogic.MatchesTwo input) :
    baseSize input = 128 ∧ exponentSize input = 3 ∧
      modulusSize input = 128 := by
  exact ⟨h.1, h.2.1, h.2.2.1⟩

private theorem gather0 (input : ByteArray)
    (h : RsaGuardLogic.MatchesTwo input) :
    Precompile.bytesToNatPadded input 96 32 = 61373713715721941618015000620724017219184713024978665880684467425338999262254 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7⟩
  have h := Challenge.EvmProof.Bytes.readWord_toNat input 96
  rw [← hw0] at h
  have hlit : ((0x87b04a7c0c814a3cd2f153933b17c61a0f920c43cc63c61604ff32d498414c2e : UInt256)).toNat = 61373713715721941618015000620724017219184713024978665880684467425338999262254 := by decide
  rw [← h]
  exact hlit

