theorem spec_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesTwo input) :
    Challenge.Modexp.spec input = Precompile.natToBytes  128 := by
  have hbs : baseSize input = 128 := (destr input h).1
  have hes : exponentSize input = 3 := (destr input h).2.1
  have hms : modulusSize input = 128 := (destr input h).2.2
  have hbase := base_eq input h
  have hexp2 := exp_eq input h
  have hmod := mod_eq input h
  have hexp2' : Precompile.bytesToNatPadded input (96 + 128) 3 = 65537 := by
    rw [show (96:ℕ) + 128 = 224 from rfl]
    exact hexp2
  have hmod' : Precompile.bytesToNatPadded input ((96 + 128) + 3) 128 =  := by
    rw [show ((96:ℕ) + 128) + 3 = 227 from rfl]
    exact hmod
  unfold Challenge.Modexp.spec
  rw [hbs, hes, hms]
  simp only [hbase, hexp2', hmod',
    Challenge.Modexp.Submission.Proofs.Algorithm.modPow_eq]
  rw [if_neg (by decide :  ≠ 0), pow_eq, if_neg (by decide : 128 ≠ 0)]

