theorem base_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesTwo input) :
    Precompile.bytesToNatPadded input 96 128 =  := by
    rw [show (128:ℕ) = 32 + (32 + (32 + (32))) from rfl,
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input 96 32 (32 + (32 + (32))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (96 + 32) 32 (32 + (32)),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((96 + 32) + 32) 32 (32),
      show (((96 + 32) + 32) + 32) = 192 from rfl,
      show ((96 + 32) + 32) = 160 from rfl,
      show (96 + 32) = 128 from rfl,
      gather0 input h, gather1 input h, gather2 input h, gather3 input h]
    decide

