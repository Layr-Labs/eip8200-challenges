theorem base_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    Precompile.bytesToNatPadded input 96 128 =  := by
    rw [show (128:ℕ) = 32 + (32 + (32 + (32))) from rfl,
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input 96 32 (32 + (32 + (32))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (96 + 32) 32 (32 + (32)),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((96 + 32) + 32) 32 (32),
      show (((96 + 32) + 32) + 32) = 192 from rfl,
      show ((96 + 32) + 32) = 160 from rfl,
      show (96 + 32) = 128 from rfl,
      gather0 input h, gather1 input h, gather2 input h, gather3 input h]
    decide

theorem mod_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    Precompile.bytesToNatPadded input 225 128 =  := by
    rw [show (128:ℕ) = 32 + (32 + (32 + (32))) from rfl,
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input 225 32 (32 + (32 + (32))),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input (225 + 32) 32 (32 + (32)),
      Challenge.EvmProof.Bytes.bytesToNatPadded_add input ((225 + 32) + 32) 32 (32),
      show (((225 + 32) + 32) + 32) = 321 from rfl,
      show ((225 + 32) + 32) = 289 from rfl,
      show (225 + 32) = 257 from rfl,
      gather4 input h, gather5 input h, gather6 input h, gather7 input h]
    decide

theorem exp_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    Precompile.bytesToNatPadded input 224 1 = 3 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7⟩
  have hsh : UInt256.ofNat ((32 - 1) * 8) = (248 : UInt256) := by decide
  have e1 : UInt256.ofNat (Precompile.bytesToNatPadded input 224 1) =
      (3 : UInt256) := by
    rw [← Challenge.EvmProof.Bytes.shiftRight_readWord input 224 1
      (by omega) (by omega)]
    rw [hsh]
    exact hexp.symm
  have e2 := congrArg UInt256.toNat e1
  have hlt : Precompile.bytesToNatPadded input 224 1 < 2 ^ 256 := by
    have hh := Challenge.EvmProof.Bytes.bytesToNatPadded_lt_pow input 224 1
    have h256 : (256:ℕ) ^ 1 < 2 ^ 256 := by decide
    omega
  have hlit : ((3 : UInt256)).toNat = 3 := by decide
  rw [Challenge.EvmProof.Word.word_toNat_ofNat, Nat.mod_eq_of_lt hlt, hlit] at e2
  exact e2

private theorem c1 :  %  =  := by decide
private theorem c2 : ( * ) %  =  := by decide
private theorem cE : ( * ) %  =  := by decide

private theorem e1 :  ^ 1 %  =  := by
  rw [pow_one]

private theorem e2 :  ^ 2 %  =  := by
  rw [show (2:ℕ) = 1 + 1 from rfl, Nat.pow_add, Nat.mul_mod, e1, c2]

theorem pow_eq :  ^ 3 %  =  := by
  rw [show (3:ℕ) = 2 + 1 from rfl, pow_succ, Nat.mul_mod, e2, c1, cE]

theorem spec_eq (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    Challenge.Modexp.spec input = Precompile.natToBytes  128 := by
  have hbs : baseSize input = 128 := (destr input h).1
  have hes : exponentSize input = 1 := (destr input h).2.1
  have hms : modulusSize input = 128 := (destr input h).2.2
  have hbase := base_eq input h
  have hexp2 := exp_eq input h
  have hmod := mod_eq input h
  have hexp2' : Precompile.bytesToNatPadded input (96 + 128) 1 = 3 := by
    rw [show (96:ℕ) + 128 = 224 from rfl]
    exact hexp2
  have hmod' : Precompile.bytesToNatPadded input ((96 + 128) + 1) 128 =  := by
    rw [show ((96:ℕ) + 128) + 1 = 225 from rfl]
    exact hmod
  unfold Challenge.Modexp.spec
  rw [hbs, hes, hms]
  simp only [hbase, hexp2', hmod',
    Challenge.Modexp.Submission.Proofs.Algorithm.modPow_eq]
  rw [if_neg (by decide :  ≠ 0), pow_eq, if_neg (by decide : 128 ≠ 0)]

end Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertOne
