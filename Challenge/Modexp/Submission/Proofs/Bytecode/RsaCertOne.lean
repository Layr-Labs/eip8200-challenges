private theorem destr (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    baseSize input = 128 ∧ exponentSize input = 1 ∧
      modulusSize input = 128 := by
  exact ⟨h.1, h.2.1, h.2.2.1⟩

private theorem gather0 (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    Precompile.bytesToNatPadded input 96 32 = 60000479258618482895755518545693443379313003549885243192520405438992775344437 := by
  rcases h with ⟨hbs, hes, hms, hexp, hw0, hw1, hw2, hw3, hw4, hw5, hw6, hw7⟩
  have h := Challenge.EvmProof.Bytes.readWord_toNat input 96
  rw [← hw0] at h
  have hlit : ((0x84a7115b1a4478cfb1df123cb8e21e1c67d741086bd7150cb84a3097bc977135 : UInt256)).toNat = 60000479258618482895755518545693443379313003549885243192520405438992775344437 := by decide
  rw [← h]
  exact hlit

