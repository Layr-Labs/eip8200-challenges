import Challenge.Modexp.Submission.Proofs.Bytecode.RsaGuardHit
import Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertOne
import Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertTwo
import Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertThree
import Challenge.Modexp.Submission.Proofs.Bytecode.RsaCertFour
import Challenge.EvmProof.Memory

set_option warningAsError true
set_option maxRecDepth 40000
set_option maxHeartbeats 5000000

/-! Hit-result bridges: the stored bytes are the specified result. -/

namespace Challenge.Modexp.Submission.Proofs.Bytecode.RsaResult

open EvmSemantics
open EvmSemantics.EVM

theorem hitMemOne_size : RsaGuardHit.hitMemOne.size = 128 := by
  simp [RsaGuardHit.hitMemOne, MachineState.writeBytes_size,
    YulEvmCompiler.BytesLemmas.natToBytesPadded_size]

theorem hitMemOne_eq : RsaGuardHit.hitMemOne =
    Precompile.natToBytes  128 := by
  apply ByteArray.ext_getElem
  · rw [hitMemOne_size, Precompile.natToBytes,
      YulEvmCompiler.BytesLemmas.natToBytesPadded_size]
  · intro k hleft hright
    rw [hitMemOne_size] at hleft
    rw [Precompile.natToBytes,
      YulEvmCompiler.BytesLemmas.natToBytesPadded_size] at hright
    have g : RsaGuardHit.hitMemOne[k]?.getD 0 =
        (Precompile.natToBytes  128)[k]?.getD 0 := by
      interval_cases k <;>
        simp only [RsaGuardHit.hitMemOne, Precompile.natToBytes,
          MachineState.writeBytes_getElem?_getD,
          YulEvmCompiler.BytesLemmas.natToBytesPadded_size,
          YulEvmCompiler.BytesLemmas.natToBytesPadded_getElem?_getD]
          <;> try decide
    rwa [Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hleft,
      Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hright] at g

theorem hReturnOne (input : ByteArray) :
    (RsaGuardHit.hitReturnedStateOne input).hReturn =
      Precompile.natToBytes  128 := by
  show MachineState.readPadded RsaGuardHit.hitMemOne 0 128 = _
  rw [hitMemOne_eq]
  have hself := Challenge.EvmProof.Memory.readPadded_zero_size
    (Precompile.natToBytes  128)
  rw [Precompile.natToBytes,
    YulEvmCompiler.BytesLemmas.natToBytesPadded_size] at hself
  exact hself

theorem hitResultOne (input : ByteArray)
    (h : RsaGuardLogic.MatchesOne input) :
    (RsaGuardHit.hitReturnedStateOne input).toResult =
      .returned (Challenge.Modexp.spec input) := by
  have hhalt : (RsaGuardHit.hitReturnedStateOne input).halt =
      .Returned := by rfl
  rw [State.toResult_returned _ hhalt, hReturnOne,
    ← RsaCertOne.spec_eq input h]

