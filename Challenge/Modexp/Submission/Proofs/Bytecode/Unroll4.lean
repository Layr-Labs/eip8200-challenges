  unfold gasSteps_bitCopy4_sym
  have c2503 := blockCostW [opAt 2503 (.Dup ⟨7, by decide⟩)] 3
    (blockOfW _ (pcFactW s 2503 3812 ([Bm1, zero, byte, offset, outerW, acc, base, m] ++ rest) (by norm_num) pc2503)
