theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8544 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6470
    (show Artifact.instructions[6470]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6470 = 8544 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
