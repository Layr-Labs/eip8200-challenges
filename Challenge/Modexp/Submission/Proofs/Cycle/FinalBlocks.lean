theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8438 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6348
    (show Artifact.instructions[6348]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6348 = 8438 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
