theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10389 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8063
    (show Artifact.instructions[8063]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8063 = 10389 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
