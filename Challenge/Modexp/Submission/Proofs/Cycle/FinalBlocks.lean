theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8804 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6630
    (show Artifact.instructions[6630]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6630 = 8804 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
