theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10204 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8013
    (show Artifact.instructions[8013]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8013 = 10204 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
