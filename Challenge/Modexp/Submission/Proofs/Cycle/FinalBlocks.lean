theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8545 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6471
    (show Artifact.instructions[6471]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6471 = 8545 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
