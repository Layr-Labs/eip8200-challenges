theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8546 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6472
    (show Artifact.instructions[6472]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6472 = 8546 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
