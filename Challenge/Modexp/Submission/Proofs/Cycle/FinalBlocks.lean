theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10342 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8015
    (show Artifact.instructions[8015]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8015 = 10342 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
