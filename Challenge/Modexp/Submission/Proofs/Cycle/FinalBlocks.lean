theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 6558 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 4832
    (show Artifact.instructions[4832]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 4832 = 6558 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
