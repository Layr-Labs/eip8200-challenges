theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10305 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8075
    (show Artifact.instructions[8075]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8075 = 10305 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
