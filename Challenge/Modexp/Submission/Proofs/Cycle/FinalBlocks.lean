theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10390 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8125
    (show Artifact.instructions[8125]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8125 = 10390 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
