theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 8558 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 6455
    (show Artifact.instructions[6455]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 6455 = 8558 := by
    rw [CycleSubmission.PCCertificate.selectedPC _ (by decide)]; rfl
  rw [hp] at h
  exact h
