theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10374 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8064
    (show Artifact.instructions[8064]? = some (.op .JUMPDEST) by rfl)
  have hp : Artifact.artifact.instructionPC 8064 = 10374 := by
    rw [PCFast.instructionPC_eq_byteLength]; rfl
  rw [hp] at h
  exact h
