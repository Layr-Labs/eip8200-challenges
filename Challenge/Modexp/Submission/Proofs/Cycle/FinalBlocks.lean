theorem validJump10857 : Decode.isValidJumpDest Artifact.bytecode 10399 = true := by
  have h := ProgramArtifact.isValidJumpDest_index Artifact.artifact 8126
    (show Artifact.instructions[8126]? = some (.op .JUMPDEST) by rfl)
