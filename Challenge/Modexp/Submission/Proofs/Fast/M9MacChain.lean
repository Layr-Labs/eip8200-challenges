    exact block0.steps (environment (chainState s (UInt256.ofNat 2682) m bi rest)
      hcode hfork hrun hnp) rfl h
  · have h := run_block s (UInt256.ofNat 2719) m bi 1280 n j 1472 2304
      (by rw [show n - 1 - j = 6 from by omega]; decide)
      (by rw [show n - 1 - j = 6 from by omega]; decide)
