    exact block1.steps (environment (chainState s (UInt256.ofNat 2719) m bi rest)
      hcode hfork hrun hnp) rfl h
  · have h := run_block s (UInt256.ofNat 2755) m bi 1280 n j 1440 2272
      (by rw [show n - 1 - j = 5 from by omega]; decide)
