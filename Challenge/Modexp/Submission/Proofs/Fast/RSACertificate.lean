theorem certificate : Precompile.modPow base 65537 modulus = answer := by
  have hm0 : modulus ≠ 0 := by norm_num [modulus]
  have hm1 : modulus ≠ 1 := by norm_num [modulus]
  have hb : base % modulus = base := by norm_num [base, modulus]
  simp [Precompile.modPow, Precompile.modPowAux, hm0, hm1, hb,
    hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7,
    hs8, hs9, hs10, hs11, hs12, hs13, hs14, hs15, hfinal]


