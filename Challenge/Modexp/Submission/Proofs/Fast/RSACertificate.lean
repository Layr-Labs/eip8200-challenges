private theorem hs0 : base * base % modulus = b1 := by
  norm_num [base, b1, modulus]
private theorem hs1 : b1 * b1 % modulus = b2 := by
  norm_num [b1, b2, modulus]
private theorem hs2 : b2 * b2 % modulus = b3 := by
  norm_num [b2, b3, modulus]
private theorem hs3 : b3 * b3 % modulus = b4 := by
  norm_num [b3, b4, modulus]
