  blk1519UnrollC0 ++ blk1519UnrollC1 ++ blk1519UnrollC2 ++ blk1519UnrollC3

def blk1519UnrollLoopContinue :=
  blk1519UnrollC4 ++ blk1519UnrollC5 ++ blk1519UnrollC6 ++ blk1519UnrollC7

